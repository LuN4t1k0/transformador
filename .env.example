NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# dev: every request is authenticated as DEV_USER_*. Any other value rejects requests (401)
# until the Previley SSO adapter is implemented.
AUTH_MODE=dev
DEV_USER_EMAIL=dev@previley.local
DEV_USER_NAME=Usuario de desarrollo
WEB_PORT=3000
POSTGRES_PORT=5434
REDIS_PORT=6380

POSTGRES_DB=transformador
POSTGRES_USER=transformador
POSTGRES_PASSWORD=transformador
DATABASE_URL=postgres://transformador:transformador@postgres:5432/transformador

REDIS_URL=redis://redis:6379

MAX_FILE_SIZE_BYTES=26214400
MAX_ROWS=100000
MAX_UNCOMPRESSED_BYTES=524288000
MAX_ACTIVE_JOBS_PER_USER=3
MAX_COLUMNS=200
MAX_SHEETS=20
MAX_CONCURRENT_JOBS=2
MAX_JOB_DURATION_MS=1800000
MAX_SAMPLE_ROWS=200
TEMP_FILE_TTL_MS=7200000
HARD_TEMP_FILE_TTL_MS=86400000
