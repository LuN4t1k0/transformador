{
  "name": "previley-excel-transformer",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic Excel transformation platform foundation for Previley.",
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up --build --renew-anon-volumes",
    "dev:detached": "docker compose up --build --renew-anon-volumes -d",
    "dev:api": "node --watch apps/api/src/server.js",
    "dev:web": "npm --workspace @previley-transformer/web run dev",
    "dev:worker": "node --watch apps/worker/src/worker.js",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "test": "node --require ./packages/packs/register.js --test tests/*.test.js",
    "lint": "node -e \"console.log('No lint configured yet')\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
